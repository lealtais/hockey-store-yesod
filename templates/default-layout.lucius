:root {
    --store-ink: #101d30;
    --store-navy: #08182b;
    --store-muted: #4c6074;
    --store-ice: #f2f6fa;
    --store-surface: #fff;
    --store-line: #d4dfe9;
    --store-link: #164a86;
    --store-focus: #1767ae;
    --store-accent: #acddfc;
    --store-radius: 14px;
}

body {
    background: var(--store-ice);
    color: var(--store-ink);
    font-family: "Segoe UI", system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.55;
}

a {
    color: var(--store-link);
}

a:focus-visible,
button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible,
[tabindex="0"]:focus-visible {
    outline: 3px solid var(--store-focus);
    outline-offset: 3px;
}

.store-skip {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 2;
    padding: 10px 14px;
    background: var(--store-surface);
    transform: translateY(-160%);
}

.store-skip:focus {
    transform: none;
}

.store-header {
    background: var(--store-surface);
    border-bottom: 1px solid var(--store-line);
}

.store-nav-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 32px;
    padding-top: 12px;
    padding-bottom: 12px;
}

.store-nav-inner::before,
.store-nav-inner::after {
    display: none;
}

.store-brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    min-height: 44px;
    color: var(--store-ink);
    font-size: 19px;
    font-weight: 750;
    white-space: nowrap;
}

.store-brand:hover,
.store-brand:focus {
    color: var(--store-link);
    text-decoration: none;
}

.store-brand-mark {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: var(--store-navy);
    color: var(--store-accent);
    font-family: Bahnschrift, "Segoe UI", sans-serif;
    font-size: 23px;
    font-weight: 700;
}

.store-nav {
    display: flex;
    flex: 1 1 460px;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
}

.store-nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
}

.store-nav-links a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 12px;
    border-radius: 8px;
    color: var(--store-muted);
    font-size: 15px;
    font-weight: 600;
}

.store-nav-links a:hover,
.store-nav-links a[aria-current="page"] {
    background: #eaf2fa;
    color: var(--store-link);
    text-decoration: none;
}

.store-nav-account {
    margin-left: auto;
}

.store-nav-account a {
    border: 1px solid var(--store-line);
    color: var(--store-ink);
}

.store-main {
    padding-top: clamp(20px, 4vw, 48px);
    padding-bottom: 56px;
}

.store-main > h1 {
    margin: 0 0 24px;
    font-size: clamp(32px, 5vw, 52px);
    font-weight: 750;
    letter-spacing: -0.035em;
}

.store-main > h2 {
    margin: 32px 0 14px;
    font-size: 24px;
    font-weight: 700;
}

.store-form {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 18px;
    padding: clamp(16px, 3vw, 26px);
    border: 1px solid var(--store-line);
    border-radius: var(--store-radius);
    background: var(--store-surface);
}

.store-main form label {
    margin-right: 10px;
}

.store-main form input:not([type="hidden"]):not([type="checkbox"]):not([type="radio"]):not([type="submit"]),
.store-main form select,
.store-main form textarea {
    min-height: 44px;
    max-width: 100%;
    padding: 6px 10px;
    border: 1px solid #8296aa;
    border-radius: 7px;
    background: var(--store-surface);
    color: var(--store-ink);
}

.store-main .btn {
    border-radius: 7px;
    font-weight: 600;
}

.store-main .btn-primary {
    border-color: var(--store-link);
    background: var(--store-link);
}

.store-main .btn-primary:hover {
    background: var(--store-navy);
}

.store-table-scroll {
    overflow-x: auto;
    border: 1px solid var(--store-line);
    border-radius: var(--store-radius);
    background: var(--store-surface);
}

.store-table-scroll .table {
    margin-bottom: 0;
}

.store-table-scroll .table th,
.store-table-scroll .table td {
    padding: 12px 14px;
    border-color: var(--store-line);
    vertical-align: middle;
}

.store-table-scroll .table th {
    background: #eaf2fa;
}

.store-table-scroll .table th:last-child,
.store-table-scroll .table td:last-child {
    white-space: nowrap;
}

@media (max-width: 600px) {
    .store-nav-inner {
        gap: 6px 12px;
    }

    .store-nav {
        flex-basis: 100%;
        gap: 4px 8px;
    }

    .store-nav-links a {
        padding-right: 8px;
        padding-left: 8px;
    }
}

.store-form input:not([type="hidden"]):not([type="checkbox"]):not([type="radio"]):not([type="submit"]),
.store-form select,
.store-form textarea {
    width: 100%;
}

.store-form-actions {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
}

.store-form-actions .btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 16px;
}

.store-table-scroll .table .store-table-empty {
    padding: 22px 14px;
    color: var(--store-muted);
    white-space: normal;
}
