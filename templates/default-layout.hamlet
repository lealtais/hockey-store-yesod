<a .store-skip href="#conteudo">Ir para o conteúdo
<header .store-header>
    <div .container.store-nav-inner>
        <a .store-brand href=@{HomeR}>
            <span .store-brand-mark aria-hidden="true">H
            <span>Hockey Store
        <nav .store-nav aria-label="Navegação principal">
            <ul .store-nav-links>
                $forall MenuItem label route _ <- navbarLeftFilteredMenuItems
                    <li>
                        <a href=@{route} :Just route == mcurrentRoute:aria-current="page">#{label}
            <ul .store-nav-links.store-nav-account>
                $forall MenuItem label route _ <- navbarRightFilteredMenuItems
                    <li>
                        <a href=@{route}>#{label}
<main #conteudo .container.store-main tabindex="-1">
    $if not (null parents)
        <ol .breadcrumb aria-label="Você está aqui">
            $forall (route, label) <- parents
                <li>
                    <a href=@{route}>#{label}
            <li .active aria-current="page">#{title}
    $maybe msg <- mmsg
        <div #message>#{msg}
    ^{widget}
